# Google OAuth public configuration. Copy to .env.local for local dev/builds.
# Never put client secrets, access tokens, or refresh tokens in VITE_* variables.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_WEB_ORIGIN=
# Optional browser-only layout testing: skip Google login in Vite development.
# Uses a separate local library with the default note; Google Drive stays off.
VITE_DEV_AUTH_BYPASS=false
# Desktop OAuth client secret, if required by Google. Rust only; NEVER use a VITE_ prefix.
# Use the secret from the Desktop app client, not the Web application client.
GOOGLE_DESKTOP_CLIENT_SECRET=
