{
  "name": "@nox/mcp",
  "version": "0.1.0",
  "description": "Native MCP tools, authorization adapters and cancellable desktop bridges for NoX apps",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapherez/mcp.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./better-auth": {
      "types": "./dist/better-auth.d.ts",
      "import": "./dist/better-auth.js"
    },
    "./bridge/client": {
      "types": "./dist/bridge-client.d.ts",
      "import": "./dist/bridge-client.js"
    },
    "./bridge/server": {
      "types": "./dist/bridge-server.d.ts",
      "import": "./dist/bridge-server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@better-auth/mcp": "^1.7.2",
    "better-auth": "^1.7.2",
    "ws": "^8.19.0",
    "zod": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/node": {
      "optional": true
    },
    "@better-auth/mcp": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@modelcontextprotocol/node": "^2.0.0",
    "@better-auth/mcp": "^1.7.2",
    "better-auth": "^1.7.2",
    "ws": "^8.19.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "zod": "^4.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
