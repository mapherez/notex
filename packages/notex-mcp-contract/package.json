{
  "name": "@notex/mcp-contract",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "generated"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && npm run generate:manifest",
    "generate:manifest": "node scripts/generate-tool-manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test run src"
  },
  "dependencies": {
    "@nox/mcp": "https://github.com/mapherez/nox-mcp/releases/download/v0.6.1/nox-mcp.tgz",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite-plus": "1.6.0"
  }
}
