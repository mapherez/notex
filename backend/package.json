{
  "name": "notex-mcp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:contract": "npm --prefix ../packages/notex-mcp-contract run build",
    "prebuild": "npm run build:contract",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "npm run build:contract && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build:contract && vitest run test",
    "test:watch": "vitest test",
    "simulate:desktop": "tsx src/simulator.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.2",
    "@better-auth/mcp": "^1.7.2",
    "@better-auth/oauth-provider": "^1.7.2",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@notex/mcp-contract": "file:../packages/notex-mcp-contract",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.19.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.13",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
