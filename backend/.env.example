NODE_ENV=development
NOTEX_MCP_PUBLIC_URL=http://127.0.0.1:8080
NOTEX_MCP_HOST=127.0.0.1
NOTEX_MCP_PORT=8080
NOTEX_MCP_DATABASE_PATH=./data/notex-mcp.sqlite
NOTEX_MCP_ALLOWED_HOSTS=localhost
NOTEX_MCP_TRUST_PROXY=
NOTEX_MCP_LOG_LEVEL=info
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
